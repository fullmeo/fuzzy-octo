<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🐙 Fuzzy-Octo - Smart Octopus AI</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            margin: 0;
            padding: 20px;
            min-height: 100vh;
        }
        
        .container {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }
        
        .octopus {
            font-size: 4rem;
            animation: float 3s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        
        .title {
            font-size: 3rem;
            margin: 20px 0;
            background: linear-gradient(45deg, #ff6b6b, #4ecdc4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .input-area {
            background: rgba(255,255,255,0.1);
            padding: 30px;
            border-radius: 20px;
            margin: 30px 0;
            backdrop-filter: blur(10px);
        }
        
        textarea {
            width: 100%;
            height: 100px;
            padding: 15px;
            border: none;
            border-radius: 10px;
            font-size: 1.1rem;
            resize: vertical;
        }
        
        button {
            background: linear-gradient(45deg, #ff6b6b, #4ecdc4);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 25px;
            font-size: 1.1rem;
            cursor: pointer;
            margin-top: 15px;
            transition: transform 0.2s;
        }
        
        button:hover {
            transform: scale(1.05);
        }
        
        .suggestions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }
        
        .suggestion {
            background: rgba(255,255,255,0.1);
            padding: 20px;
            border-radius: 15px;
            text-align: left;
            backdrop-filter: blur(10px);
        }
        
        .tentacle {
            font-size: 2rem;
            display: inline-block;
        }

        /* === PINKY POULPE MAGIC === */
        .pinky-hero {
            position: relative;
            display: inline-block;
            margin-bottom: 20px;
        }

        .pinky-octopus {
            font-size: 5rem;
            position: relative;
            display: inline-block;
            filter: hue-rotate(320deg) saturate(1.8) brightness(1.2);
            animation: pinky-float 3s ease-in-out infinite;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .pinky-octopus:hover {
            transform: scale(1.1);
            filter: hue-rotate(320deg) saturate(2.2) brightness(1.4);
        }

        .pinky-heart {
            position: absolute;
            top: -15px;
            right: -15px;
            font-size: 1.8rem;
            animation: heart-pulse 2s infinite;
            z-index: 2;
        }

        .sparkle-trail {
            position: absolute;
            top: -30px;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 60px;
        }

        .sparkle {
            position: absolute;
            font-size: 1.5rem;
            animation: sparkle-dance 4s infinite;
            opacity: 0.8;
        }

        .sparkle:nth-child(1) {
            left: 0;
            animation-delay: 0s;
        }

        .sparkle:nth-child(2) {
            left: 40px;
            animation-delay: 1.3s;
        }

        .sparkle:nth-child(3) {
            left: 80px;
            animation-delay: 2.6s;
        }

        .pinky-tagline {
            font-size: 1.3rem;
            color: #FFB6C1;
            font-weight: 600;
            text-shadow: 0 0 10px rgba(255, 182, 193, 0.5);
            margin-top: 10px;
        }

        @keyframes pinky-float {
            0%, 100% {
                transform: translateY(0px) rotate(-3deg);
            }
            33% {
                transform: translateY(-12px) rotate(1deg);
            }
            66% {
                transform: translateY(-6px) rotate(2deg);
            }
        }

        @keyframes heart-pulse {
            0%, 100% {
                transform: scale(1) rotate(0deg);
                opacity: 1;
            }
            50% {
                transform: scale(1.4) rotate(10deg);
                opacity: 0.8;
            }
        }

        @keyframes sparkle-dance {
            0% {
                opacity: 0;
                transform: translateY(0px) rotate(0deg) scale(0.5);
            }
            25% {
                opacity: 1;
                transform: translateY(-20px) rotate(90deg) scale(1.2);
            }
            50% {
                opacity: 0.7;
                transform: translateY(-35px) rotate(180deg) scale(1);
            }
            75% {
                opacity: 1;
                transform: translateY(-45px) rotate(270deg) scale(1.3);
            }
            100% {
                opacity: 0;
                transform: translateY(-60px) rotate(360deg) scale(0.3);
            }
        }

        .pinky-octopus:active {
            animation: pinky-celebration 0.6s ease;
        }

        @keyframes pinky-celebration {
            0% { transform: scale(1) rotate(0deg); }
            25% { transform: scale(1.3) rotate(-15deg); }
            50% { transform: scale(1.2) rotate(15deg); }
            75% { transform: scale(1.3) rotate(-10deg); }
            100% { transform: scale(1) rotate(0deg); }
        }
    </style>

.pinky-octopus {
    font-size: 5rem;
    position: relative;
    display: inline-block;
    filter: hue-rotate(320deg) saturate(1.8) brightness(1.2);
    animation: pinky-float 3s ease-in-out infinite;
    cursor: pointer;
    transition: all 0.3s ease;
}

.pinky-octopus:hover {
    transform: scale(1.1);
    filter: hue-rotate(320deg) saturate(2.2) brightness(1.4);
}

.pinky-heart {
    position: absolute;
    top: -15px;
    right: -15px;
    font-size: 1.8rem;
    animation: heart-pulse 2s infinite;
    z-index: 2;
}

.sparkle-trail {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 60px;
}

.sparkle {
    position: absolute;
    font-size: 1.5rem;
    animation: sparkle-dance 4s infinite;
    opacity: 0.8;
}

.sparkle:nth-child(1) {
    left: 0;
    animation-delay: 0s;
}

.sparkle:nth-child(2) {
    left: 40px;
    animation-delay: 1.3s;
}

.sparkle:nth-child(3) {
    left: 80px;
    animation-delay: 2.6s;
}

.pinky-tagline {
    font-size: 1.3rem;
    color: #FFB6C1;
    font-weight: 600;
    text-shadow: 0 0 10px rgba(255, 182, 193, 0.5);
    margin-top: 10px;
}

/* === ANIMATIONS PINKY === */
@keyframes pinky-float {
    0%, 100% { 
        transform: translateY(0px) rotate(-3deg);
    }
    33% { 
        transform: translateY(-12px) rotate(1deg);
    }
    66% { 
        transform: translateY(-6px) rotate(2deg);
    }
}

@keyframes heart-pulse {
    0%, 100% { 
        transform: scale(1) rotate(0deg);
        opacity: 1;
    }
    50% { 
        transform: scale(1.4) rotate(10deg);
        opacity: 0.8;
    }
}

@keyframes sparkle-dance {
    0% { 
        opacity: 0;
        transform: translateY(0px) rotate(0deg) scale(0.5);
    }
    25% { 
        opacity: 1;
        transform: translateY(-20px) rotate(90deg) scale(1.2);
    }
    50% { 
        opacity: 0.7;
        transform: translateY(-35px) rotate(180deg) scale(1);
    }
    75% { 
        opacity: 1;
        transform: translateY(-45px) rotate(270deg) scale(1.3);
    }
    100% { 
        opacity: 0;
        transform: translateY(-60px) rotate(360deg) scale(0.3);
    }
}

/* === PINKY INTERACTIVITY === */
.pinky-octopus:active {
    animation: pinky-celebration 0.6s ease;
}

@keyframes pinky-celebration {
    0% { transform: scale(1) rotate(0deg); }
    25% { transform: scale(1.3) rotate(-15deg); }
    50% { transform: scale(1.2) rotate(15deg); }
    75% { transform: scale(1.3) rotate(-10deg); }
    100% { transform: scale(1) rotate(0deg); }
}
</head>
<body>
    <div class="container">
        <div class="pinky-hero">
    <div class="pinky-octopus">
        🐙<span class="pinky-heart">💕</span>
    </div>
    <div class="sparkle-trail">
        <span class="sparkle">✨</span>
        <span class="sparkle">✨</span>
        <span class="sparkle">✨</span>
    </div>
</div>
<h1 class="title">Fuzzy-Octo</h1>
<p class="pinky-tagline">💕 Smart has never been this cute! 🐙</p>
        <p>The Smart Octopus AI that transforms your fuzzy ideas into precise code</p>
        
        <div class="input-area">
            <textarea 
                id="fuzzyInput" 
                placeholder="Tell me what you want to code... 
                
Examples:
- I need something that sorts data
- Make a function that validates emails  
- Create authentication stuff
- Build a API thing for users"
            ></textarea>
            <br>
            <button onclick="askOctopus()">🐙 Ask the Smart Octopus</button>
        </div>
        
        <div id="results"></div>
    </div>

    <script>
        async function askOctopus() {
            const query = document.getElementById('fuzzyInput').value;
            const resultsDiv = document.getElementById('results');
            
            if (!query.trim()) {
                alert('🐙 The octopus needs something to think about!');
                return;
            }
            
            resultsDiv.innerHTML = '<div style="text-align: center; font-size: 1.5rem;">🐙 The octopus is thinking...</div>';
            
            try {
                const response = await fetch('/fuzzy', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ query })
                });
                
                const data = await response.json();
                displaySuggestions(data);
            } catch (error) {
                resultsDiv.innerHTML = '<div style="color: #ff6b6b;">🐙 Oops! The octopus had a tentacle tangle!</div>';
            }
        }
        
        function displaySuggestions(data) {
            const resultsDiv = document.getElementById('results');
            
            let html = `
                <h2>🐙 The Smart Octopus suggests:</h2>
                <p><strong>Your fuzzy idea:</strong> "${data.query}"</p>
                <div class="suggestions">
            `;
            
            data.suggestions.forEach(suggestion => {
                html += `
                    <div class="suggestion">
                        <div class="tentacle">${suggestion.tentacle}</div>
                        <h3>${suggestion.type} Solution</h3>
                        <pre style="background: rgba(0,0,0,0.3); padding: 10px; border-radius: 5px; overflow-x: auto;">${suggestion.code}</pre>
                        <p><em>${suggestion.explanation}</em></p>
                    </div>
                `;
            });
            
            html += '</div>';
            resultsDiv.innerHTML = html;
        }
        
        // Allow Enter key to submit
        document.getElementById('fuzzyInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && e.ctrlKey) {
                askOctopus();
            }
        });
    </script>
</body>
</html>
